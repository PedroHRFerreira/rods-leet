# Browser-safe values only. Empty values keep the local catalog in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only after configuring Google OAuth in Supabase.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_API_URL=

# Supabase Edge secrets: configure with `supabase secrets set`, never prefix VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5173
COORDINATOR_SECRET=
E2B_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Operational scripts only; use a separate secret store / GitHub environment.
DATABASE_URL=
BACKUP_AGE_RECIPIENT=
BACKUP_S3_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
