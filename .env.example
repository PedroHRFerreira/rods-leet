# Local exploration: no remote requests or simulated XP; public local practice is available.
# Production uses the same-origin BFF; leave this unset or true there.
VITE_BFF_ENABLED=false

# Optional rollback of browser practice; rebuild after changing. Default: enabled.
VITE_LOCAL_PRACTICE_ENABLED=true

# Supabase Edge secrets: configure with `supabase secrets set`, never prefix VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5173
COORDINATOR_SECRET=
E2B_API_KEY=
EXECUTION_PROVIDER=disabled
LOCAL_EXECUTOR_URL=
LOCAL_EXECUTOR_TOKEN=
EXECUTOR_IMAGE=rods-leet-executor:local
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=8789
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Operational scripts only; use a separate secret store / GitHub environment.
DATABASE_URL=
BACKUP_AGE_RECIPIENT=
BACKUP_S3_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Internal feedback notification: Google-generated app password; server only.
GMAIL_APP_PASSWORD=
